# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.log
.claude/

# Design reference files, working frames, and raw assets
/Images/
/References/
/scratch/
*.bin
*.mp4
*.mp3

# Temporary captures and test images
*shot*.png
*crop*.png
*test*.*
all_sections.png

# Unused boilerplate assets
/public/logo.jpg
/public/logo.png
/public/file.svg
/public/globe.svg
/public/next.svg
/public/vercel.svg
/public/window.svg

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# environment variables (NEVER commit secrets or API keys)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
